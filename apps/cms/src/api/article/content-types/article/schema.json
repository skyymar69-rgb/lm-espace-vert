{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Articles du blog jardinage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "extrait": {
      "type": "text",
      "maxLength": 300
    },
    "contenu": {
      "type": "richtext",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "categorie": {
      "type": "enumeration",
      "enum": ["creation", "entretien", "elagage", "maconnerie", "arrosage", "saisonnier", "conseils", "geo"],
      "default": "conseils"
    },
    "tempsLecture": {
      "type": "integer",
      "default": 5
    },
    "auteur": {
      "type": "string",
      "default": "Léo Maurice"
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 160
    }
  }
}
