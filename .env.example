# ============================================================
# Front-end (apps/web)
# ============================================================
NEXT_PUBLIC_SITE_URL=https://www.lm-espace-vert.fr
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lm-espace-vert.fr
NEXT_PUBLIC_CMS_URL=https://cms.lm-espace-vert.fr
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side only
STRAPI_API_TOKEN=
# Requis pour l'envoi des emails des formulaires (contact, devis, newsletter).
# Clé Resend « re_... » — https://resend.com/api-keys
RESEND_API_KEY=
# Destinataire de toutes les demandes du site
CONTACT_TO=lmespacevert069@gmail.com
# Expéditeur. « onboarding@resend.dev » marche sans DNS mais n'envoie qu'à
# l'adresse du compte Resend. Après vérification du domaine dans Resend,
# utiliser : LM Espace Vert <contact@lm-espace-vert.fr>
CONTACT_FROM=LM Espace Vert <onboarding@resend.dev>
TURNSTILE_SECRET_KEY=
REVALIDATE_SECRET=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ============================================================
# CMS (apps/cms)
# ============================================================
HOST=0.0.0.0
PORT=1337
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
DATABASE_CLIENT=postgres
DATABASE_URL=

# Media storage (Cloudinary)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
